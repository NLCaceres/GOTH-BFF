package view

import "github.com/NLCaceres/goth-example/internal/model"

templ Path(title string, items []model.Item) {
  <div class="slides-up transitionable">
    <h1>{ title } - Normal Links</h1>
    <p>Links that simply take the user to the URL provided by the Item struct</p>
    {{ url := func(i model.Item) string { return i.URL } }}
    {{ expectedLink := func(i model.Item) string { return "/" + i.URL } }}
    @itemList(items, url, expectedLink)

    <h1>{ title } - Traditional Hashed Same Page Links</h1>
    <p>Links that link to the same page by appending a hash and the section name to the URL</p>
    {{ hashURL := func(i model.Item) string { return "#" + i.URL } }}
    {{ hashExpectedLink := func(i model.Item) string { return "/" + i.Name + "#" + i.URL } }}
    @itemList(items, hashURL, hashExpectedLink)

    <h1>{ title } - Modern Slashed then Hashed Same Page Links</h1>
    <p>Links that append a slash before appending the usual hash and section name to the URL</p>
    {{ slashHashURL := func(i model.Item) string { return i.Name + "/#" + i.URL } }}
    {{ slashHashExpectedLink := func(i model.Item) string { return "/" + i.Name + "/#" + i.URL } }}
    @itemList(items, slashHashURL, slashHashExpectedLink)
  </div>
}

templ itemList(
  items []model.Item, urlGenerator func(model.Item) string, expectedLink func(model.Item) string,
) {
  <ol>
    for _, item := range items {
      <li class="grid listItem">
        <div class="itemName centered cross-centered">
          <p>{ item.Name }</p>
        </div>
        {{ link := templ.URL(urlGenerator(item)) }}
        <div class="itemLink centered cross-centered">
          <a href={ link }>Links to: { `"` + expectedLink(item) + `"` }</a>
        </div>
        <div class="itemButton centered cross-centered">
          <button type="button">Done?</button>
        </div>
      </li>
    }
  </ol>
}
