package reusable

import "fmt"

templ Pagination(currentPage, pageTotal int) {
  <div class="flex my-8" style="height:45px;">
    @pages(currentPage, pageTotal)
  </div>
  { children... }
  <div class="flex" style="height:45px;">
    @pages(currentPage, pageTotal)
  </div>
}

templ pages(currentPage, pageTotal int) {
  if currentPage != 1 {
    <a href={fmt.Sprintf("?page=%d", currentPage-1)} class="text-white fw-bolder flex w-5
      full-centered border-white rounded-l hover:bg-gray-400 hover:text-black
      hover:outline-black-inset focus:bg-gray-400 focus:text-black focus:outline-black-inset">
        Back
    </a>
  }
  if currentPage > 2 {
    @pageLink(currentPage - 2)
  }
  if currentPage > 1 {
    @pageLink(currentPage - 1)
  }

  <a href={fmt.Sprintf("?page=%d", currentPage)} class="bg-white text-black fw-bolder w-5 flex
    full-centered outline-black-inset hover:bg-black hover:border-2-white hover:text-white
    focus:bg-black focus:border-2-white focus:text-white">
      { currentPage }
  </a>

  if pageTotal > 1 && currentPage < pageTotal {
    @pageLink(currentPage + 1)
  }
  if pageTotal > 2 && currentPage + 1 < pageTotal {
    @pageLink(currentPage + 2)
  }
  if pageTotal > 1 && currentPage < pageTotal {
    <a href={fmt.Sprintf("?page=%d", currentPage+1)} class="text-white fw-bolder flex w-5
      full-centered border-white rounded-r hover:bg-gray-400 hover:text-black
      hover:outline-black-inset focus:bg-gray-400 focus:text-black focus:outline-black-inset">
        Next
    </a>
  }
}

templ pageLink(page int) {
  <a href={fmt.Sprintf("?page=%d", page)} class="text-white fw-bolder flex w-5
    full-centered border-white hover:bg-gray-400 hover:text-black hover:outline-black-inset
    focus:bg-gray-400 focus:text-black focus:outline-black-inset">
      { page }
  </a>
}
