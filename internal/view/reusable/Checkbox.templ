package reusable

templ Checkbox() {
<button class="checkbox-button"
  style="height:100%;width:100%;background-color: transparent;border:none;margin:1rem 0.75rem 1rem 0.5rem;">
  <svg viewBox="0 0 36 36" height="100%" width="100%"
    style="stroke-width:5;stroke-linecap:square;">
    <!-- X-mark -->
    <path d="M0 0 L36 36 M36 0 L0 36 M0 0" stroke="red" fill="none">
      <animate id="x-animation" begin="indefinite" fill="freeze" attributeName="d" 
        dur="500ms" to="M0 0 L36 36 M36 0 L0 36 M0 0"/>
      <animate id="red-animation" begin="indefinite" fill="freeze" attributeName="stroke" 
        dur="500ms" to="red"/>
      <!-- Checkmark -->
      <animate id="check-animation" begin="indefinite" fill="freeze" attributeName="d" 
        dur="500ms" to="M0 22 L20 36 L33.5 0 M0 18"/>
      <animate id="green-animation" begin="indefinite" fill="freeze" attributeName="stroke" 
        dur="500ms" to="green"/>
    </path>
  </svg>
</button>

  <script>
    function handleClick(e) {
      if (e.currentTarget.classList.contains('check')) {
        document.getElementById('x-animation').beginElement();
        document.getElementById('red-animation').beginElement();
        e.currentTarget.classList.remove('check');
      } else {
        document.getElementById('check-animation').beginElement();
        document.getElementById('green-animation').beginElement();
        e.currentTarget.classList.add('check');
      }
    }
    for (const button of document.getElementsByClassName('checkbox-button')) {
      button.addEventListener('click', handleClick);
    }
  </script>
}
