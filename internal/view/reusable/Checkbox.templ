package reusable

import "strconv"

var checkboxScript = templ.NewOnceHandle()

templ Checkbox(id int) {
<button class="checkbox-button" data-id={id} 
  style="height:100%;width:100%;background-color: transparent;border:none;margin:1rem 0.75rem 1rem 0.5rem;">
  <svg viewBox="0 0 36 36" height="60%" width="60%" style="stroke-width:5px;">
    <!-- X-mark -->
    <path d="M0,0 L36,36 L18,18 L36,0 L0,36 L18,18z" style="stroke:red">
      <animate id={"x-animation-" + strconv.Itoa(id)} begin="indefinite" fill="freeze"
        attributeName="d" dur="500ms" to="M0,0 L36,36 L18,18 L36,0 L0,36 L18,18z"/>
      <animate id={"red-animation-" + strconv.Itoa(id)} begin="indefinite"
        fill="freeze" attributeName="stroke" dur="500ms" to="red"/>
      <!-- Checkmark -->
      <animate id={"check-animation-" + strconv.Itoa(id)} begin="indefinite" fill="freeze"
        attributeName="d" dur="500ms" to="M0,22 L20,36 L33.5,0 L20,36 L10,29 L0,22z"/>
      <animate id={"green-animation-" + strconv.Itoa(id)} begin="indefinite"
        fill="freeze" attributeName="stroke" dur="500ms" to="green"/>
    </path>
  </svg>
</button>

  @checkboxScript.Once() {
    <script>
      function handleClick(e) {
        const dataId = e.currentTarget.dataset.id;
        if (e.currentTarget.classList.contains('check')) {
          document.getElementById('x-animation-'+dataId).beginElement();
          document.getElementById('red-animation-'+dataId).beginElement();
          e.currentTarget.classList.remove('check');
        } else {
          document.getElementById('check-animation-'+dataId).beginElement();
          document.getElementById('green-animation-'+dataId).beginElement();
          e.currentTarget.classList.add('check');
        }
      }
      window.addEventListener('DOMContentLoaded', function() {
        for (const button of document.getElementsByClassName('checkbox-button')) {
          button.addEventListener('click', handleClick);
        }
      })
    </script>
  }
}
