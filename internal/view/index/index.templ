package index

import (
  "os"
  "strings"
	"github.com/NLCaceres/goth-example/internal/view/reusable/htmx"
)

templ HTML(contents templ.Component, vm ViewModel) {
<!DOCTYPE html>
<html>
  @head(vm.Title, vm.CssPaths)
  <body>
    @navbar(strings.Split(os.Getenv("APP_ROUTES"), ","))
    <main class="flex centered h-100 mx-4 md:mx-8">
      @contents
    </main>
    @htmx.LoadingIndicator()
  </body>
</html>
}
