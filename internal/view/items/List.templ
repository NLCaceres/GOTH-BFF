package items

import (
  "github.com/NLCaceres/goth-example/internal/model"
	"github.com/NLCaceres/goth-example/internal/view/reusable"
)

templ ListPage(vm ViewModel) {
  <div>
    <h1>{ vm.Title } - Normal Links</h1>
    <p>Links that simply take the user to the URL provided by the Item struct</p>
    @list(vm.Items)
  </div>
  <script type="module" src="js/items.js"></script>
}

templ list(items []model.Item) {
  <ul class="items mx-8 md:mx-16 xl:mx-8 my-8">
    for i, item := range items {
      <li class="grid listItem grid-transition mb-12">
        <div class="itemName flex centered cross-centered bg-gray-700">
          <div class="itemNameCover flex centered cross-centered bg-red">
            <p class="itemNameID text-xl fw-bolder">{ i + 1 }</p>
          </div>
        </div>
        <div class="itemLink flex flex-column bg-gray-700 hide-overflow py-1">
          <a href={ item.URL } class="text-xl">
            { item.Name }
          </a>
          <p class="m-0 mt-1 text-white white-space-pre-line clip-overflow">
            { item.Description }
          </p>
        </div>
        <div class="itemButton flex centered cross-centered bg-gray-700 p-relative">
          @reusable.BackingCircle(i % 2 == 0, "red")
          @reusable.Checkbox(i)
        </div>
      </li>
    }
  </ul>
}

